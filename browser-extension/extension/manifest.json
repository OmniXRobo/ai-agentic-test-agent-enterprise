{
  "manifest_version": 3,
  "name": "SkyGuard Adaptive AI Agent",
  "short_name": "SkyGuard Agent",
  "version": "1.0.0",
  "description": "Learns your web applications with your approval and operates them through their normal screens, with preview, confirmation and verification. Runs with a local companion: nothing leaves this PC.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "scripting",
    "tabs",
    "notifications"
  ],
  "optional_permissions": [
    "debugger"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "SkyGuard Adaptive AI Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
